# Frontend (Vite — valores públicos, van en el bundle)
# Vacío = modo 100% local (sin Supabase). Solo configura un proyecto propio si lo necesitas.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Wompi: solo llave PÚBLICA y entorno en frontend
VITE_WOMPI_PUBLIC_KEY=pub_prod_hlVp9WgGN0kWFjDJjNx4wQbDxq1RF0Gw
VITE_WOMPI_ENV=production

# GEMINI_API_KEY: AI Studio la inyecta en runtime desde secretos de usuario.
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# APP_URL: URL pública donde corre la tienda (usada como redirect-url de Wompi).
APP_URL="http://localhost:3000/"

# ------------------------------------------------------------------
# Backend (server/index.ts — SECRETOS, nunca van al bundle ni a git)
# Copia este bloque a .env.local (gitignored). En VPS/Render, ponlos
# como variables de entorno del servicio.
# ------------------------------------------------------------------
# Puerto del backend Express (Vite proxea /api → aquí en dev)
PORT=4001
# production | sandbox
WOMPI_ENV=production
WOMPI_PUBLIC_KEY=pub_prod_TU_LLAVE_PUBLICA
WOMPI_PRIVATE_KEY=prv_prod_TU_LLAVE_PRIVADA
WOMPI_INTEGRITY_SECRET=prod_integrity_TU_SECRETO
WOMPI_EVENTS_SECRET=prod_events_TU_SECRETO
# Supabase leído por el backend (webhook). Vacío = sin conexión (modo local).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# WhatsApp Meta Cloud API (pídela y pégala aquí, NO en el frontend)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# ------------------------------------------------------------------
# Admin (server/index.ts)
# Sesión firmada HMAC (12h). Genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ADMIN_SESSION_SECRET=
# Solo para crear/rotar la contraseña inicial (npm run seed:admin). Bórrala después.
# ADMIN_EMAIL=
# ADMIN_PASSWORD= (mínimo 10 caracteres)
